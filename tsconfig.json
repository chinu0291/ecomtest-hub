{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
"moduleResolution": "NodeNext",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": [
      "node",
      "@playwright/test"
    ],

    "noEmit": true
  },

  "include": [
    "pages/**/*.ts",
    "tests/**/*.ts",
    "test-data/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts"
  ],

  "exclude": [
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}